# Copy to .env and fill in
GEMINI_API_KEY=your_gemini_key_here
GOOGLE_API_KEY=your_gemini_key_here
FILMHUB_DB=data/filmhub_library.db
# RAG knobs (deploy-friendly defaults)
RAG_EMBEDDINGS=gemini
RAG_EMBEDDING_MODEL=models/text-embedding-004
RAG_CHAT_MODEL=gemini-1.5-flash
RAG_LLM_EXPAND=0
RAG_CSV=data/imdb_cleaned.csv
RAG_FAISS_DIR=vectorstore/filmhub_lc_faiss
# Post-retrieval quality floors (0 = off; or per-request ?min_rating=&min_metascore=)
MIN_IMDB=0
MIN_METASCORE=0
# Hybrid CF (BPR-lite from SQLite ratings): 1 = on when 2+ users rated
HYBRID_CF=1
CF_ALPHA=0.7
CF_MIN_OVERLAP=1
# Official plots (free keys; leave empty to skip enrichment)
TMDB_API_KEY=
OMDB_API_KEY=
